    {
      "name": "C002 - Provide order ID and verify refund",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"{{c002_conversation_id}}\",\n  \"customer_id\": \"C002\",\n  \"message\": \"ORD10002\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/chat",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const actionTrace = (body.trace || []).find((entry) => entry.agent === 'action');",
              "pm.test('trace confirms a successful refund action', function () {",
              "  pm.expect(actionTrace, 'action trace entry').to.exist;",
              "  pm.expect(actionTrace.output_summary).to.include('initiate_refund');",
              "  const actions = body.state.actions.actions_executed || [];",
              "  pm.expect(actions.some((action) => action.tool_name === 'initiate_refund' && action.success)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
