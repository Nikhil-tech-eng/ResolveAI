    {
      "name": "C005 - Shipped order cancellation is blocked",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"C005\",\n  \"message\": \"cancel ORD10005\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/chat",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('explains the cancellation policy block', function () {",
              "  pm.expect(body.state.proposed_action).to.eql('escalate_policy_block');",
              "  const reply = String(body.reply || '').toLowerCase();",
              "  pm.expect(/only orders with status|cannot cancel|policy/.test(reply)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Tickets and select a transitionable ticket",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/tickets",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "tickets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200 and a ticket list', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });",
              "const tickets = pm.response.json();",
              "const nextByStatus = { opened: 'assigned', assigned: 'pending_customer', pending_customer: 'assigned', resolved: 'opened' };",
              "const ticket = tickets.find((item) => nextByStatus[item.status]);",
              "pm.test('contains a ticket with a valid next transition', function () { pm.expect(ticket).to.exist; });",
              "if (ticket) {",
              "  pm.collectionVariables.set('ticket_id', String(ticket.id));",
              "  pm.collectionVariables.set('ticket_next_status', nextByStatus[ticket.status]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH - Valid ticket status transition",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"{{ticket_next_status}}\",\n  \"actor\": \"postman\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/tickets/{{ticket_id}}",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "tickets",
            "{{ticket_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('applies the requested valid status', function () { pm.expect(pm.response.json().status).to.eql(pm.collectionVariables.get('ticket_next_status')); });"
            ]
          }
        }
      ]
    },
