{
  "info": {
    "name": "ResolveAI API",
    "description": "Smoke checks for chat workflows and support API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "C001 - Wrong item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"C001\",\n  \"message\": \"I got the wrong item\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/chat",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8000",
          "path": [
            "chat"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns HTTP 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('includes a reply and no ticket', function () {",
              "  pm.expect(body.reply).to.be.a('string').and.not.empty;",
              "  pm.expect(body.ticket === null || body.ticket === undefined).to.eql(true);",
              "});",
              "pm.collectionVariables.set('csat_conversation_id', body.conversation_id);"
            ]
          }
        }
      ]
    },
